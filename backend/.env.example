# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# =============================================================================
# POSTGRESQL DATABASE (Control Plane)
# =============================================================================
DB_ENGINE=postgresql
DB_NAME=hostinger_platform
DB_USER=hostinger_admin
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# For Docker Compose, use:
# DB_HOST=db_system

# =============================================================================
# DATABASE SSL/TLS (Production)
# =============================================================================
# DB_SSL_MODE=require
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem
# DB_SSL_ROOT_CERT=/path/to/ca-cert.pem

# =============================================================================
# CLOUDFLARE TUNNEL CONFIGURATION
# =============================================================================
CLOUDFLARE_DOMAIN=edubricz.online
CLOUDFLARE_TUNNEL_ID=f7a24d5d-ea18-477f-bd26-6dfc0f3b2774
CLOUDFLARE_CREDENTIALS_FILE=/home/user/.cloudflared/f7a24d5d-ea18-477f-bd26-6dfc0f3b2774.json

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily

# =============================================================================
# TENANT DATABASE DEFAULTS
# =============================================================================
TENANT_DB_IMAGE=mysql:8.0
TENANT_DB_ROOT_PASSWORD=auto-generated
TENANT_DB_NETWORK=tenant_isolated

# =============================================================================
# AWS S3 BACKUP CONFIGURATION
# =============================================================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET_NAME=hostinger-backups-unique-id
AWS_S3_REGION=ap-south-1
S3_BACKUP_RETENTION_DAYS=7

# =============================================================================
# COMPUTE / LOCAL EC2 (libvirt)
# =============================================================================
# Use a libvirt-readable path for local development. Avoid storing compute assets
# under /home/<user>/... when using qemu:///system.
COMPUTE_STORAGE_ROOT=/tmp/host-compute
COMPUTE_IMAGES_DIR=/tmp/host-compute/images
COMPUTE_DISKS_DIR=/tmp/host-compute/disks
COMPUTE_SEEDS_DIR=/tmp/host-compute/seeds
COMPUTE_VM_UEFI_VARS_DIR=/tmp/host-compute/nvram
COMPUTE_VM_ENABLE_UEFI=false
COMPUTE_VM_VIRT_TYPE=kvm
